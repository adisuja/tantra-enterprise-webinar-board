/* Creates any missing tab and header, seeds Lists, stores the sheet id, makes the shared secret,
 * and installs the 5-minute runner trigger. Safe to run again. */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var props = PropertiesService.getScriptProperties();
  props.setProperty('SHEET_ID', ss.getId());
  ensureTabs_(ss);
  applySheetTimeZone_(ss);
  if (!props.getProperty('SHARED_SECRET')) props.setProperty('SHARED_SECRET', Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''));
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'runFollowUps') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('runFollowUps').timeBased().everyMinutes(5).create();
  var msg = 'Set up done. Runner installed (every 5 minutes).\n\nYour shared secret (Project Settings, Script Properties, SHARED_SECRET) is:\n\n' +
    props.getProperty('SHARED_SECRET') + '\n\nAdd it to the web app URL as ?k=<secret> wherever a tool posts to the CRM. Never put it in the repo.';
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { Logger.log(msg); }
}

/* Timestamps written as dates show in the spreadsheet's timezone. The CRM runs on UK time
 * (webinar.timezone, Lists setting default_timezone), whatever the owner's Google account uses. */
function applySheetTimeZone_(ss) {
  var tz = setting_('default_timezone', 'Europe/London') || 'Europe/London';
  if (ss.getSpreadsheetTimeZone && ss.getSpreadsheetTimeZone() !== tz) ss.setSpreadsheetTimeZone(tz);
  return tz;
}

function ensureTabs_(ss) {
  ss = ss || ss_();
  Object.keys(SCHEMA.tabs).concat(['Lists']).forEach(function (name) {
    var sh = ss.getSheetByName(name) || ss.insertSheet(name);
    if (name === 'Lists') {
      if (sh.getLastRow() < 2) seedLists_(sh);
      else upgradeLists_(sh);
      return;
    }
    var cols = SCHEMA.tabs[name];
    var have = sh.getLastColumn() ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String) : [];
    var missing = cols.filter(function (c) { return have.indexOf(c) < 0; });
    if (!have.filter(Boolean).length) sh.getRange(1, 1, 1, cols.length).setValues([cols]);
    else if (missing.length) sh.getRange(1, have.length + 1, 1, missing.length).setValues([missing]);
  });
}

function seedLists_(sh) {
  var keys = Object.keys(SCHEMA.lists);
  var header = keys.concat(['', 'closer_name', 'closer_email', 'closer_whatsapp', 'closer_calcom', 'closer_call2_url', '', 'setting', 'value', 'setting_note']);
  var depth = Math.max.apply(null, keys.map(function (k) { return SCHEMA.lists[k].length; }).concat([SCHEMA.settings.length]));
  var rows = [header];
  for (var r = 0; r < depth; r++) {
    var row = keys.map(function (k) { return SCHEMA.lists[k][r] === undefined ? '' : SCHEMA.lists[k][r]; });
    row.push('');
    var c = SCHEMA.closers[r];
    row = row.concat(c ? [c.closer_name, c.closer_email, c.closer_whatsapp, c.closer_calcom, c.closer_call2_url] : ['', '', '', '', '']);
    row.push('');
    var s = SCHEMA.settings[r];
    row = row.concat(s ? [s.setting, s.value, s.setting_note] : ['', '', '']);
    rows.push(row);
  }
  sh.getRange(1, 1, rows.length, header.length).setValues(rows);
}

/* An already seeded Lists tab keeps every value typed into it; Set up only adds what a newer version needs:
 * missing header columns (for example closer_call2_url) and missing settings rows (for example calcom_call2_slug). */
function upgradeLists_(sh) {
  var head = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0].map(function (h) { return String(h).trim(); });
  ['closer_call2_url'].forEach(function (h) {
    if (head.indexOf(h) < 0) { sh.getRange(1, head.length + 1).setValue(h); head.push(h); }
  });
  var sc = head.indexOf('setting');
  if (sc < 0) return;
  var n = Math.max(sh.getLastRow() - 1, 1);
  var have = sh.getRange(2, sc + 1, n, 1).getValues().map(function (r) { return String(r[0]).trim(); });
  var last = 0;
  have.forEach(function (v, i) { if (v) last = i + 1; });
  // The live sheet was seeded before the webinar timezone was decided: replace that placeholder only.
  var vc = head.indexOf('value'), tzRow = have.indexOf('default_timezone');
  var tzWant = SCHEMA.settings.filter(function (s) { return s.setting === 'default_timezone'; })[0];
  if (vc >= 0 && tzRow >= 0 && tzWant && String(sh.getRange(tzRow + 2, vc + 1).getValue()).trim() === 'America/New_York') {
    sh.getRange(tzRow + 2, vc + 1).setValue(tzWant.value);
    if (head.indexOf('setting_note') >= 0) sh.getRange(tzRow + 2, head.indexOf('setting_note') + 1).setValue(tzWant.setting_note);
  }
  var missing = SCHEMA.settings.filter(function (s) { return have.indexOf(s.setting) < 0; });
  if (missing.length) sh.getRange(last + 2, sc + 1, missing.length, 3).setValues(missing.map(function (s) { return [s.setting, s.value, s.setting_note]; }));
}

/* ---------- rep actions on the selected Pipeline row ---------- */

function menuEvent_(event, needs, extra) {
  var ui = SpreadsheetApp.getUi();
  var sh = SpreadsheetApp.getActiveSheet();
  if (sh.getName() !== 'Pipeline') { ui.alert('Select the deal row on the Pipeline tab first.'); return; }
  var r = sh.getActiveRange().getRow();
  if (r < 2) { ui.alert('Select a deal row, not the header.'); return; }
  resetTables_();
  var t = tab_('Pipeline');
  load_(t);
  var deal = { i: r - 2, o: obj_(t, t.data[r - 2] || []) };
  var missing = (needs || []).filter(function (k) { return blank_(deal.o[k]); });
  if (missing.length) { ui.alert('Fill ' + missing.join(' and ') + ' on this row first.'); return; }
  var data = {};
  ['notes', 'budget', 'objections', 'deal_value', 'proposal_url', 'lost_reason', 'paid_at'].forEach(function (k) { if (!blank_(deal.o[k])) data[k] = deal.o[k]; });
  data.channel = 'logged by rep';
  Object.keys(extra || {}).forEach(function (k) { data[k] = extra[k]; });
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var res = processEvent_({ event: event, email: deal.o.email, source: 'sheet', ts: now_().toISOString(), data: data });
    flushAll_();
    SpreadsheetApp.getActive().toast(event + ': ' + res, 'Tantra CRM', 6);
  } finally {
    lock.releaseLock();
  }
}

function menuConfirmed() { menuEvent_('call.confirmed'); }
function menuShowed() { menuEvent_('call.showed'); }
function menuNoShow() { menuEvent_('call.no_show'); }
function menuNotReady() { menuEvent_('call.not_ready', ['notes']); }
function menuProposalSent() { menuEvent_('proposal.sent', ['proposal_url']); }
function menuCall2Showed() { menuEvent_('call.showed', [], { call: 2 }); }
function menuCall2NoShow() { menuEvent_('call.no_show', [], { call: 2 }); }
function menuWon() { menuEvent_('deal.won'); }
function menuLost() { menuEvent_('deal.lost', ['lost_reason']); }
function menuReplied() { menuEvent_('contact.replied'); }
function menuOptedOut() { menuEvent_('contact.opted_out'); }

function menuMarkSent() {
  var ui = SpreadsheetApp.getUi();
  var sh = SpreadsheetApp.getActiveSheet();
  if (sh.getName() !== 'Sequences') { ui.alert('Select the row on the Sequences tab first.'); return; }
  var r = sh.getActiveRange().getRow();
  resetTables_();
  var t = tab_('Sequences');
  load_(t);
  var h = { i: r - 2, o: obj_(t, t.data[r - 2] || []) };
  if (['due', 'pending', 'blocked'].indexOf(String(h.o.status)) < 0) { ui.alert('This row is ' + h.o.status + '.'); return; }
  put_(t, h, { status: h.o.channel === 'task' ? 'done' : 'sent', sent_at: now_() });
  flushAll_();
  SpreadsheetApp.getActive().toast('Marked ' + (h.o.channel === 'task' ? 'done' : 'sent'), 'Tantra CRM', 4);
}
