/* ===== 1_core.gs ===== */
/* Core: clock, tables, settings, closers, rendering. */

function now_() { return new Date(); }

function ss_() {
  var id = PropertiesService.getScriptProperties().getProperty('SHEET_ID');
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

/* ---------- tables: one in-memory copy per run, written back by flushAll_ ---------- */

var TABLES_ = {};

function resetTables_() { TABLES_ = {}; }

function tab_(name) {
  if (TABLES_[name]) return TABLES_[name];
  var sheet = ss_().getSheetByName(name);
  if (!sheet) throw new Error('Missing tab ' + name + '. Run Tantra CRM, Set up.');
  var width = Math.max(sheet.getLastColumn(), 1);
  var headers = sheet.getRange(1, 1, 1, width).getValues()[0].map(function (h) { return String(h).trim(); });
  var t = { name: name, sh: sheet, headers: headers, col: {}, data: null, dirty: {}, added: 0, baseRows: 0 };
  headers.forEach(function (h, i) { if (h && t.col[h] === undefined) t.col[h] = i; });
  TABLES_[name] = t;
  return t;
}

function load_(t) {
  if (t.data) return t.data;
  var n = t.sh.getLastRow();
  t.data = n < 2 ? [] : t.sh.getRange(2, 1, n - 1, t.headers.length).getValues();
  t.baseRows = t.data.length;
  return t.data;
}

function ensureCol_(t, h) {
  if (t.col[h] !== undefined) return t.col[h];
  var c = t.headers.length;
  t.sh.getRange(1, c + 1).setValue(h);
  t.headers.push(h);
  t.col[h] = c;
  return c;
}

function obj_(t, row) {
  var o = {};
  t.headers.forEach(function (h, i) { if (h) o[h] = row[i] === undefined ? '' : row[i]; });
  return o;
}

/* Last row where field equals value (and pred passes). Returns {i, o} or null. */
function find_(t, field, value, pred) {
  load_(t);
  var c = t.col[field];
  if (c === undefined) return null;
  var want = norm_(value);
  for (var i = t.data.length - 1; i >= 0; i--) {
    if (norm_(t.data[i][c]) === want) {
      var o = obj_(t, t.data[i]);
      if (!pred || pred(o)) return { i: i, o: o };
    }
  }
  return null;
}

function each_(t, fn) {
  load_(t);
  for (var i = 0; i < t.data.length; i++) fn({ i: i, o: obj_(t, t.data[i]) });
}

function put_(t, hit, patch) {
  var row = t.data[hit.i];
  Object.keys(patch).forEach(function (k) {
    var c = ensureCol_(t, k);
    while (row.length < t.headers.length) row.push('');
    row[c] = patch[k];
    hit.o[k] = patch[k];
  });
  if (hit.i < t.baseRows) t.dirty[hit.i] = true;
  return hit;
}

function add_(t, o) {
  load_(t);
  Object.keys(o).forEach(function (k) { ensureCol_(t, k); });
  var row = t.headers.map(function (h) { return o[h] === undefined ? '' : o[h]; });
  t.data.push(row);
  t.added++;
  return { i: t.data.length - 1, o: obj_(t, row) };
}

function flushAll_() {
  Object.keys(TABLES_).forEach(function (name) {
    var t = TABLES_[name];
    if (!t.data) return;
    var w = t.headers.length;
    var pad = function (r) { while (r.length < w) r.push(''); return r.slice(0, w); };
    Object.keys(t.dirty).forEach(function (i) {
      i = Number(i);
      t.sh.getRange(i + 2, 1, 1, w).setValues([pad(t.data[i])]);
    });
    if (t.added) {
      var fresh = t.data.slice(t.baseRows).map(pad);
      t.sh.getRange(t.baseRows + 2, 1, fresh.length, w).setValues(fresh);
    }
    t.dirty = {};
    t.added = 0;
    t.baseRows = t.data.length;
  });
}

/* ---------- small helpers ---------- */

function norm_(v) { return String(v === null || v === undefined ? '' : v).trim().toLowerCase(); }
function blank_(v) { return v === null || v === undefined || String(v).trim() === '' || /^FILL_/.test(String(v)); }
function truthy_(v) { return v === true || /^(true|yes|on|1)$/i.test(String(v).trim()); }
function isEmail_(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v || '').trim()); }

function toDate_(v) {
  if (v instanceof Date) return v;
  if (blank_(v)) return null;
  var d = new Date(v);
  return isNaN(d.getTime()) ? null : d;
}

function addMin_(d, m) { return new Date(d.getTime() + m * 60000); }

function uid_(prefix) {
  return prefix + Utilities.formatDate(now_(), 'UTC', 'yyMMddHHmmss') + Math.floor(Math.random() * 1e6);
}

function json_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

/* ---------- settings and closers (Lists tab) ---------- */

function settings_() {
  if (TABLES_._settings) return TABLES_._settings;
  var t = tab_('Lists'), s = {};
  each_(t, function (h) { if (!blank_(h.o.setting)) s[String(h.o.setting).trim()] = String(h.o.value === undefined ? '' : h.o.value).trim(); });
  TABLES_._settings = s;
  return s;
}

function setting_(k, dflt) {
  var v = settings_()[k];
  return v === undefined || v === '' ? (dflt === undefined ? '' : dflt) : v;
}

function closers_() {
  var t = tab_('Lists'), out = [];
  each_(t, function (h) {
    if (!blank_(h.o.closer_name)) out.push({ name: String(h.o.closer_name).trim(), email: blank_(h.o.closer_email) ? '' : String(h.o.closer_email).trim(), whatsapp: blank_(h.o.closer_whatsapp) ? '' : String(h.o.closer_whatsapp).trim(), call2_url: blank_(h.o.closer_call2_url) ? '' : String(h.o.closer_call2_url).trim() });
  });
  return out;
}

function closerByEmail_(email) {
  var e = norm_(email);
  var hit = closers_().filter(function (c) { return c.email && norm_(c.email) === e; })[0];
  return hit ? hit.name : '';
}

/* The closer's own Proposal Review (Call 2) booking link. Empty or FILL_: the placeholder blocks the message. */
function closerCall2Url_(name) {
  var hit = closers_().filter(function (c) { return norm_(c.name) === norm_(name); })[0];
  return hit && hit.call2_url ? hit.call2_url : 'FILL_CLOSER_CALL2_URL';
}

function personEmail_(name) {
  if (!blank_(setting_('setter_name')) && norm_(name) === norm_(setting_('setter_name')) && !blank_(setting_('setter_email'))) return setting_('setter_email');
  var hit = closers_().filter(function (c) { return norm_(c.name) === norm_(name); })[0];
  return hit ? hit.email : '';
}

/* ---------- time zones ---------- */

function fmt_(d, tz, pattern) { return Utilities.formatDate(d, tz, pattern); }

function localHour_(d, tz) { return Number(fmt_(d, tz, 'H')); }

/* Next moment at or after d that falls inside the WhatsApp window, in tz. */
function whatsappWindow_(d, tz) {
  var start = Number(setting_('whatsapp_start_hour', 8)), end = Number(setting_('whatsapp_end_hour', 20));
  var h = localHour_(d, tz);
  if (h >= start && h < end) return d;
  var m = Number(fmt_(d, tz, 'm'));
  var minsToStart = h < start ? (start - h) * 60 - m : (24 - h + start) * 60 - m;
  return addMin_(d, minsToStart);
}

function tzOf_(contact) {
  var tz = contact && !blank_(contact.timezone) ? String(contact.timezone) : '';
  return tz || setting_('default_timezone', 'Europe/London');
}

/* ---------- rendering ---------- */

function mergeFields_(contact, deal) {
  var tz = tzOf_(contact);
  var call = toDate_(deal && deal.call_date), call2 = toDate_(deal && deal.call2_date);
  var s = settings_();
  return {
    first_name: contact.first_name || 'there',
    closer: (deal && deal.closer) || 'the Tantra team',
    company: contact.company || '',
    call_day: call ? fmt_(call, tz, 'EEEE d MMMM') : '',
    call_time: call ? fmt_(call, tz, 'h:mm a') : '',
    lead_timezone: tz,
    join_link: (deal && deal.join_link) || 'the Google Meet link in your calendar invite',
    reschedule_link: deal && !blank_(deal.cal_uid) ? 'https://app.cal.com/reschedule/' + deal.cal_uid : (s.booking_url || ''),
    booking_link: s.booking_url || '',
    proposal_url: (deal && deal.proposal_url) || '',
    goal: contact.bottleneck || '',
    call_notes: (deal && deal.notes) || '',
    due_diligence_url: s.due_diligence_url || '',
    onboarding_link: s.onboarding_link || '',
    call2_link: closerCall2Url_(deal && deal.closer),
    call2_day: call2 ? fmt_(call2, tz, 'EEEE d MMMM') : '',
    call2_time: call2 ? fmt_(call2, tz, 'h:mm a') : '',
    call2_join_link: (deal && deal.call2_join_link) || 'the Google Meet link in your calendar invite',
    call2_reschedule_link: deal && !blank_(deal.call2_cal_uid) ? 'https://app.cal.com/reschedule/' + deal.call2_cal_uid : closerCall2Url_(deal && deal.closer)
  };
}

/* Fills {{fields}}. Lines starting with ? are dropped when a field in them is empty. */
function render_(text, f) {
  if (!text) return '';
  return String(text).split('\n').map(function (line) {
    var optional = line.charAt(0) === '?';
    if (optional) line = line.slice(1);
    var missing = false;
    var out = line.replace(/\{\{(\w+)\}\}/g, function (_, k) {
      var v = f[k];
      if (v === undefined || v === null || String(v) === '') { missing = true; return ''; }
      return String(v);
    });
    return optional && missing ? null : out;
  }).filter(function (l) { return l !== null; }).join('\n').replace(/\n{3,}/g, '\n\n');
}


/* ===== 2_events.gs ===== */
/* Web app: POST {crm_webhook_url}?k=<SHARED_SECRET>. Body is a CRM_CONTRACT event, a raw Cal.com webhook or a raw Tantra webhook. */

var CONTRACT_EVENTS = ['webinar.registered', 'webinar.attended', 'webinar.no_show', 'webinar.poll_answered',
  'webinar.cta_clicked', 'booking.created', 'booking.rescheduled', 'booking.cancelled', 'call.confirmed',
  'call.showed', 'call.no_show', 'call.not_ready', 'proposal.sent', 'deal.won', 'deal.lost', 'sequence.sent',
  'contact.quick_reply', 'contact.replied', 'contact.opted_out'];

var CLOSED = ['7 Closed Won', '8 Closed Lost'];

function doGet() { return json_({ ok: true, service: 'Tantra Enterprise CRM' }); }

function doPost(e) {
  resetTables_();
  var secret = PropertiesService.getScriptProperties().getProperty('SHARED_SECRET');
  if (!secret || !e || !e.parameter || e.parameter.k !== secret) return json_({ ok: false, error: 'unauthorized' });
  var body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: 'body is not JSON' }); }
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (busy) {
    return json_({ ok: false, error: 'busy' });
  }
  try {
    var dedupe = dedupeKey_(body);
    var cache = CacheService.getScriptCache();
    if (dedupe && cache.get(dedupe)) return json_({ ok: true, duplicate: true });
    var events = toContract_(body);
    var errors = [];
    events.forEach(function (ev) { var r = processEvent_(ev); if (r !== 'ok' && /^error/.test(r)) errors.push(r); });
    flushAll_();
    if (dedupe && !errors.length) cache.put(dedupe, '1', 21600);
    return errors.length ? json_({ ok: false, error: errors.join('; ') }) : json_({ ok: true });
  } catch (err) {
    try { flushAll_(); } catch (ignored) {}
    return json_({ ok: false, error: String(err && err.message || err) });
  } finally {
    lock.releaseLock();
  }
}

function dedupeKey_(b) {
  if (b.eventId) return 'tantra:' + b.eventId;
  if (b.triggerEvent) {
    var p = b.payload || b;
    var who = (p.attendees || []).map(function (a) { return a.email + ':' + a.noShow; }).join(',');
    return 'cal:' + b.triggerEvent + ':' + (p.uid || p.bookingUid || p.bookingId || '') + ':' + (p.startTime || '') + ':' + who;
  }
  if (b.idempotency_key) return 'k:' + b.idempotency_key;
  return '';
}

/* ---------- adapters: raw webhooks to contract events ---------- */

function toContract_(b) {
  if (b && b.event) return [b];
  if (b && b.triggerEvent) return fromCalcom_(b);
  if (b && b.eventType) return fromTantra_(b);
  return [{ event: '(unknown body)', email: '', data: {} }];
}

function calAnswer_(p, slug) {
  var r = (p.responses && p.responses[slug]) || (p.userFieldsResponses && p.userFieldsResponses[slug]);
  if (r === undefined || r === null) return '';
  var v = (typeof r === 'object' && !Array.isArray(r) && 'value' in r) ? r.value : r;
  if (Array.isArray(v)) return v.join(', ');
  if (v && typeof v === 'object') return [v.firstName, v.lastName].filter(Boolean).join(' ');
  return String(v);
}

function fromCalcom_(b) {
  var p = b.payload || (/^MEETING_/.test(b.triggerEvent) ? b : {}), trig = b.triggerEvent;
  var slug = setting_('calcom_event_slug', 'enterprise-evaluation-call');
  var slug2 = setting_('calcom_call2_slug', 'proposal-review');
  if (p.type && slug && p.type !== slug && p.type !== slug2) return [{ event: '(ignored) cal ' + trig + ' for event type ' + p.type, email: '', data: {} }];
  // The event type slug is the Call 2 marker (CRM_CONTRACT "Call 2"). No type: the handlers match the booking uid.
  var callNo = !p.type ? '' : p.type === slug2 ? 2 : 1;
  if (trig === 'BOOKING_NO_SHOW_UPDATED') {
    return (p.attendees || []).map(function (a) {
      if (a.noShow === true) return { event: 'call.no_show', email: a.email, source: 'calcom', ts: b.createdAt || '', data: { cal_uid: p.bookingUid || '', call: callNo } };
      return { event: '(task) cal no-show unmarked', email: a.email, source: 'calcom', ts: b.createdAt || '', data: { cal_uid: p.bookingUid || '', call: callNo } };
    });
  }
  var att = (p.attendees || [])[0] || {};
  var email = att.email || calAnswer_(p, 'email');
  var name = calAnswer_(p, 'name') || att.name || '';
  var parts = String(name).trim().split(/\s+/);
  var org = p.organizer || {};
  var answers = {
    revenue_band: calAnswer_(p, 'revenue_band'), invest_12m: calAnswer_(p, 'invest_12m').trim().toLowerCase(),
    main_channel: calAnswer_(p, 'main_channel'), bottleneck: calAnswer_(p, 'bottleneck'), signoff: calAnswer_(p, 'signoff')
  };
  var join = (p.metadata && p.metadata.videoCallUrl) || (p.videoCallData && p.videoCallData.url) || (/^https?:\/\//.test(p.location || '') ? p.location : '');
  var data = {
    cal_uid: p.uid || '', start: p.startTime || '', closer: closerByEmail_(org.email) || String(org.name || '').split(' ')[0],
    answers: answers, first_name: parts[0] || '', last_name: parts.slice(1).join(' '),
    company: calAnswer_(p, 'company'), whatsapp: calAnswer_(p, 'whatsapp') || calAnswer_(p, 'attendeePhoneNumber'),
    timezone: att.timeZone || att.timezone || '', join_link: join, reason: p.cancellationReason || '', call: callNo
  };
  var map = { BOOKING_CREATED: 'booking.created', BOOKING_RESCHEDULED: 'booking.rescheduled', BOOKING_CANCELLED: 'booking.cancelled' };
  if (map[trig]) return [{ event: map[trig], email: email, source: 'calcom', ts: b.createdAt || '', data: data }];
  if (trig === 'MEETING_ENDED') return [{ event: '(task) cal MEETING_ENDED', email: email, source: 'calcom', ts: b.createdAt || '', data: data }];
  return [{ event: '(ignored) cal ' + trig, email: email, data: {} }];
}

function fromTantra_(b) {
  var email = (b.guest && b.guest.email) || (b.contact && b.contact.email) || (b.recipient && b.recipient.email) || b.email || '';
  var text = (b.message && b.message.text) || b.text || (b.reply && b.reply.text) || '';
  var channel = b.channel || String(b.eventType).split('.')[0];
  var base = { email: email, source: 'tantra', ts: b.occurredAt ? new Date(Number(b.occurredAt) * 1000).toISOString() : '' };
  if (/unsubscribed$/.test(b.eventType) || /^\s*stop\b/i.test(text)) return [merge_(base, { event: 'contact.opted_out', data: { channel: channel } })];
  var kw = String(text).trim().toUpperCase().replace(/[^A-Z]/g, '');
  if (/replied$/.test(b.eventType) && ['YES', 'CAL', 'CANT'].indexOf(kw) >= 0) return [merge_(base, { event: 'contact.quick_reply', data: { channel: channel, keyword: kw } })];
  if (/replied$/.test(b.eventType)) return [merge_(base, { event: 'contact.replied', data: { channel: channel, text: text } })];
  return [merge_(base, { event: '(ignored) tantra ' + b.eventType, data: {} })];
}

function merge_(a, b) { var o = {}; [a, b].forEach(function (x) { Object.keys(x).forEach(function (k) { o[k] = x[k]; }); }); return o; }

/* ---------- the event processor ---------- */

function processEvent_(ev) {
  var email = norm_(ev.email);
  var data = ev.data || {};
  var result;
  try {
    if (/^\(ignored\)/.test(ev.event)) result = 'ignored';
    else if (ev.event === '(task) cal MEETING_ENDED') result = onMeetingEnded_(email, data);
    else if (ev.event === '(task) cal no-show unmarked') result = onNoShowUnmarked_(email);
    else if (CONTRACT_EVENTS.indexOf(ev.event) < 0) result = 'error: unknown event ' + ev.event;
    else if (!isEmail_(email)) result = 'error: missing or bad email';
    else result = HANDLERS[ev.event](email, data, ev) || 'ok';
  } catch (err) {
    result = 'error: ' + (err && err.message || err);
  }
  var dj = JSON.stringify(data);
  add_(tab_('Events'), {
    received_at: now_(), kind: ev.source === 'runner' ? 'runner' : 'post', event: ev.event, email: email,
    source: ev.source || '', ts: ev.ts || '', webinar_date: ev.webinar_date || '',
    data_json: dj.length > 45000 ? dj.slice(0, 45000) : dj, result: result
  });
  return result;
}

function logRunner_(email, what, result) {
  add_(tab_('Events'), { received_at: now_(), kind: 'runner', event: what, email: email, source: 'runner', ts: '', webinar_date: '', data_json: '', result: result });
}

/* ---------- contacts, webinar rows, deals ---------- */

var CONTACT_FIELDS = ['first_name', 'last_name', 'company', 'phone', 'whatsapp', 'whatsapp_opt_in', 'call_opt_in', 'newsletter_opt_in', 'timezone',
  'revenue_band', 'invest_12m', 'main_channel', 'bottleneck', 'signoff'];

function upsertContact_(email, d, evName) {
  var t = tab_('Contacts');
  var hit = find_(t, 'email', email);
  var patch = {};
  var flat = merge_(d || {}, (d && d.answers) || {});
  CONTACT_FIELDS.forEach(function (f) { if (!blank_(flat[f])) patch[f] = flat[f]; });
  if (blank_(flat.whatsapp) && !blank_(flat.phone) && truthy_(flat.whatsapp_opt_in) && (!hit || blank_(hit.o.whatsapp))) patch.whatsapp = flat.phone;
  ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (f) {
    if (!blank_(flat[f]) && (!hit || blank_(hit.o[f]))) patch[f] = flat[f];
  });
  if (!hit || blank_(hit.o.lead_source)) {
    var src = SCHEMA.lists.lead_source.indexOf(flat.lead_source) >= 0 ? flat.lead_source
      : (/^webinar\./.test(evName) || !blank_(flat.utm_source) ? 'Webinar' : '');
    if (src) patch.lead_source = src;
  }
  patch.updated_at = now_();
  if (!hit) {
    patch.email = email;
    patch.created_at = now_();
    patch.hot_lead = false;
    patch.do_not_contact = false;
    patch.no_rebook = false;
    return add_(t, patch);
  }
  return put_(t, hit, patch);
}

function webinarRow_(email, date) {
  if (blank_(date)) throw new Error('webinar_date is required');
  var t = tab_('Webinar');
  var key = email + '|' + date;
  return find_(t, 'key', key) || add_(t, { key: key, email: email, webinar_date: date, attended: false, cta_clicked: false });
}

function openDeal_(email) {
  return find_(tab_('Pipeline'), 'email', email, function (o) { return CLOSED.indexOf(String(o.stage)) < 0; });
}

function newDeal_(email, contact, stage) {
  var c = contact.o;
  var hit = add_(tab_('Pipeline'), {
    deal_id: uid_('D'), email: email, first_name: c.first_name || '', company: c.company || '', stage: stage,
    lead_source: c.lead_source || '', revenue_band: c.revenue_band || '', invest_12m: c.invest_12m || '',
    created_at: now_(), stage_changed_at: now_(), updated_at: now_()
  });
  startStageSequences_(hit, stage);
  return hit;
}

function setStage_(deal, stage, why) {
  if (String(deal.o.stage) === stage) return deal;
  var from = deal.o.stage;
  put_(tab_('Pipeline'), deal, { stage: stage, stage_changed_at: now_(), updated_at: now_() });
  cancelSeqs_(deal.o.email, function (s) { return s.valid_stages.indexOf(stage) < 0; }, 'stage moved to ' + stage);
  startStageSequences_(deal, stage);
  if (why === 'runner') logRunner_(deal.o.email, 'stage ' + from + ' to ' + stage, 'ok');
  return deal;
}

function startStageSequences_(deal, stage) {
  Object.keys(SEQUENCES).forEach(function (id) {
    if (SEQUENCES[id].trigger === 'stage:' + stage) startSeq_(id, deal);
  });
}

/* ---------- sequences ---------- */

function assigneeFor_(step, deal) {
  if (step.channel === 'system') return '';
  if (step.assignee === 'setter') return setting_('setter_name') || deal.o.setter || deal.o.closer || '';
  return deal.o.closer || '';
}

function startSeq_(id, deal) {
  var seq = SEQUENCES[id];
  var t = tab_('Sequences');
  var call = toDate_(seq.call === 2 ? deal.o.call2_date : deal.o.call_date);
  var nowD = now_();
  seq.steps.forEach(function (st) {
    var due, status = 'pending', note = '';
    if (st.from === 'call_start') {
      if (!call) return;
      due = addMin_(call, st.minutes);
      if (due < nowD) { status = 'skipped'; note = 'booked inside this window'; }
    } else {
      due = addMin_(nowD, st.minutes);
    }
    add_(t, {
      id: uid_('S'), created_at: nowD, email: deal.o.email, deal_id: deal.o.deal_id, sequence: id, step: st.id,
      channel: st.channel, due_at: due, status: status, sent_at: '', assignee: assigneeFor_(st, deal),
      subject: '', text: '', note: note
    });
  });
}

/* Cancel pending or due rows for this email whose sequence matches pred(seqDef, row). */
function cancelSeqs_(email, pred, reason, includeAdhoc) {
  var t = tab_('Sequences');
  var n = 0;
  each_(t, function (h) {
    if (norm_(h.o.email) !== norm_(email)) return;
    if (['pending', 'due'].indexOf(String(h.o.status)) < 0) return;
    var seq = SEQUENCES[h.o.sequence];
    if (seq ? pred(seq, h.o) : includeAdhoc) { put_(t, h, { status: 'cancelled', note: reason }); n++; }
  });
  return n;
}

function cancelIds_(email, ids, reason) {
  return cancelSeqs_(email, function (s, row) { return ids.indexOf(row.sequence) >= 0; }, reason);
}

/* ---------- handlers, one per contract event ---------- */

var HANDLERS = {
  'webinar.registered': function (email, d, ev) {
    upsertContact_(email, d, ev.event);
    var w = webinarRow_(email, ev.webinar_date);
    var reg = { registered_at: toDate_(ev.ts) || now_(), segment: w.o.segment || 'registered', updated_at: now_() };
    if (!blank_(d.join_url)) reg.join_url = String(d.join_url);
    put_(tab_('Webinar'), w, reg);
    return 'ok (pre-webinar nurture is item 15b)';
  },
  'webinar.attended': function (email, d, ev) {
    upsertContact_(email, d, ev.event);
    // Contract attendance rule: attended always means attended; minutes floored at 1. Only webinar.no_show sets no_show.
    var mins = Math.max(1, Math.round(Number(d.minutes_in_room) || 0));
    var cutoff = Number(setting_('retarget_cutoff_minute', 25));
    var w = webinarRow_(email, ev.webinar_date);
    var seg = mins >= cutoff ? 'stayed_to_offer' : 'early_leaver';
    put_(tab_('Webinar'), w, {
      attended: true, minutes_in_room: mins, joined_at: d.joined_at || '', left_at: d.left_at || '',
      segment: seg, retarget_until: seg === 'stayed_to_offer' ? '' : retargetUntil_(ev.webinar_date), updated_at: now_()
    });
    return 'ok ' + seg;
  },
  'webinar.no_show': function (email, d, ev) {
    upsertContact_(email, d, ev.event);
    var w = webinarRow_(email, ev.webinar_date);
    if (truthy_(w.o.attended)) return 'ok (already attended, kept)';
    put_(tab_('Webinar'), w, { attended: false, minutes_in_room: 0, segment: 'no_show', retarget_until: retargetUntil_(ev.webinar_date), updated_at: now_() });
    return 'ok no_show';
  },
  'webinar.poll_answered': function (email, d, ev) {
    upsertContact_(email, d, ev.event);
    var t = tab_('Webinar');
    var w = webinarRow_(email, ev.webinar_date);
    var colName = 'poll_' + String(d.poll_id || 'x').replace(/[^\w]/g, '_');
    var patch = { updated_at: now_() };
    patch[colName] = d.answer || '';
    put_(t, w, patch);
    return 'ok';
  },
  'webinar.cta_clicked': function (email, d, ev) {
    var c = upsertContact_(email, d, ev.event);
    put_(tab_('Contacts'), c, { hot_lead: true });
    var w = webinarRow_(email, ev.webinar_date);
    var ids = String(w.o.cta_ids || '').split(',').filter(Boolean);
    if (d.cta_id && ids.indexOf(String(d.cta_id)) < 0) ids.push(String(d.cta_id));
    put_(tab_('Webinar'), w, { cta_clicked: true, cta_ids: ids.join(','), updated_at: now_() });
    if (truthy_(c.o.do_not_contact)) return 'ok (do not contact: no task)';
    var deal = openDeal_(email);
    if (!deal) { newDeal_(email, c, '1 New Lead'); startSeq_('HOT', openDeal_(email)); return 'ok new lead + hot task'; }
    if (String(deal.o.stage) === '9 Nurture') { setStage_(deal, '1 New Lead'); startSeq_('HOT', deal); return 'ok nurture to new lead + hot task'; }
    return 'ok (deal already at ' + deal.o.stage + ')';
  },
  'booking.created': function (email, d, ev) {
    if (callNo_(openDeal_(email), d) === 2) return onCall2Booking_(email, d, ev, 'Booked');
    var c = upsertContact_(email, d, ev.event);
    var deal = openDeal_(email);
    if (!deal) {
      var won = find_(tab_('Pipeline'), 'email', email, function (o) { return o.stage === '7 Closed Won'; });
      if (won) { alertCloser_('booking by an existing client', won, c, d); return 'ok (existing client booked: closer alerted, no sequences)'; }
      deal = newDeal_(email, c, '2 Call Booked');
    }
    var closer = d.closer || deal.o.closer || '';
    put_(tab_('Pipeline'), deal, {
      cal_uid: d.cal_uid || '', call_date: toDate_(d.start) || '', closer: closer,
      setter: setting_('setter_name') || closer, show_status: '', join_link: d.join_link || '',
      revenue_band: c.o.revenue_band || '', invest_12m: c.o.invest_12m || '', company: c.o.company || deal.o.company,
      first_name: c.o.first_name || deal.o.first_name, next_follow_up: toDate_(d.start) || '', next_action: 'Confirm, research, take the call',
      updated_at: now_()
    });
    // The lead booked: stop every chasing sequence, then restart booking logistics.
    cancelSeqs_(email, function (s) { return s.stops_on_reply; }, 'lead booked');
    cancelIds_(email, ['SET', 'A', 'B'], 'replaced by a new booking');
    setStage_(deal, '2 Call Booked');
    ['SET', 'A', 'B'].forEach(function (id) { startSeq_(id, deal); });
    alertCloser_('new booking', deal, c, d);
    return 'ok booked with ' + (closer || 'unassigned closer');
  },
  'booking.rescheduled': function (email, d, ev) {
    if (callNo_(openDeal_(email), d) === 2) return onCall2Booking_(email, d, ev, 'Rescheduled');
    var c = upsertContact_(email, d, ev.event);
    var deal = openDeal_(email);
    if (!deal) return HANDLERS['booking.created'](email, d, ev);
    put_(tab_('Pipeline'), deal, {
      cal_uid: d.cal_uid || deal.o.cal_uid, call_date: toDate_(d.start) || deal.o.call_date, show_status: 'Rescheduled',
      closer: d.closer || deal.o.closer, join_link: d.join_link || deal.o.join_link, next_follow_up: toDate_(d.start) || '', updated_at: now_()
    });
    cancelIds_(email, ['SET', 'A', 'B'], 'rescheduled');
    cancelSeqs_(email, function (s) { return s.stops_on_reply; }, 'lead rebooked');
    setStage_(deal, '2 Call Booked');
    ['SET', 'A', 'B'].forEach(function (id) { startSeq_(id, deal); });
    alertCloser_('rescheduled', deal, c, d);
    return 'ok rescheduled';
  },
  'booking.cancelled': function (email, d, ev) {
    var c = upsertContact_(email, d, ev.event);
    var deal = openDeal_(email);
    if (!deal) return 'ok (no open deal)';
    if (callNo_(deal, d) === 2) return onCall2Cancelled_(deal, c, d);
    var note = 'Cancelled ' + Utilities.formatDate(now_(), 'UTC', 'yyyy-MM-dd') + (d.reason ? ': ' + d.reason : '');
    put_(tab_('Pipeline'), deal, { notes: [deal.o.notes, note].filter(Boolean).join('\n'), next_action: 'Rebook (Seq. E running)', updated_at: now_() });
    cancelIds_(email, ['SET', 'A', 'B'], 'booking cancelled');
    setStage_(deal, '1 New Lead');
    if (!truthy_(c.o.do_not_contact)) startSeq_('E', deal);
    return 'ok cancelled, Seq. E started';
  },
  'call.confirmed': function (email, d) {
    var deal = needDeal_(email);
    if (String(deal.o.stage) !== '2 Call Booked') return 'ok (stage is ' + deal.o.stage + ', unchanged)';
    setStage_(deal, '3 Confirmed');
    cancelIds_(email, ['SET'], 'confirmed');
    return 'ok confirmed';
  },
  'call.showed': function (email, d) {
    var deal = needDeal_(email);
    if (callNo_(deal, d, true) === 2) return onCall2Showed_(deal, d);
    put_(tab_('Pipeline'), deal, pick_(d, ['notes', 'budget', 'objections'], { show_status: 'Showed', next_action: 'Proposal within one business day, or Not ready', next_follow_up: addMin_(now_(), 1440), updated_at: now_() }));
    setStage_(deal, '4a Showed');
    startSeq_('PRO', deal);
    return 'ok showed';
  },
  'call.no_show': function (email, d) {
    var deal = needDeal_(email);
    if (callNo_(deal, d, true) === 2) return onCall2NoShow_(deal, email);
    if (String(deal.o.stage) === '4b No-Show') return 'ok (already no-show)';
    put_(tab_('Pipeline'), deal, { show_status: 'No-Show', next_action: setting_('seq_c_rebook') === 'ON' ? 'Seq. C rebook running' : 'No rebook (description rule); Nurture at +7 days', updated_at: now_() });
    if (setting_('seq_c_rebook') !== 'ON') put_(tab_('Contacts'), find_(tab_('Contacts'), 'email', email), { no_rebook: true });
    setStage_(deal, '4b No-Show');
    startSeq_('C', deal);
    return 'ok no-show, Seq. C started (rebook ' + (setting_('seq_c_rebook') === 'ON' ? 'ON' : 'OFF') + ')';
  },
  'call.not_ready': function (email, d) {
    var deal = needDeal_(email);
    put_(tab_('Pipeline'), deal, pick_(d, ['notes'], { show_status: 'Showed', next_action: 'Seq. F: recap, value, 30-day check-in', updated_at: now_() }));
    setStage_(deal, '4a Showed');
    cancelIds_(email, ['PRO'], 'not ready');
    startSeq_('F', deal);
    return 'ok not ready, Seq. F started';
  },
  'proposal.sent': function (email, d) {
    var deal = needDeal_(email);
    put_(tab_('Pipeline'), deal, pick_(d, ['deal_value', 'proposal_url'], { proposal_sent_at: now_(), next_follow_up: addMin_(now_(), 1440), next_action: 'Seq. D running', updated_at: now_() }));
    if (blank_(deal.o.deal_value)) put_(tab_('Pipeline'), deal, { deal_value: 9999 });
    setStage_(deal, '5 Proposal Sent');
    startSeq_('D', deal);
    return 'ok proposal sent, Seq. D started';
  },
  'deal.won': function (email, d) {
    var deal = needDeal_(email);
    put_(tab_('Pipeline'), deal, pick_(d, ['deal_value', 'paid_at'], { next_action: 'Onboarding', next_follow_up: '', updated_at: now_() }));
    if (blank_(deal.o.deal_value)) put_(tab_('Pipeline'), deal, { deal_value: 9999 });
    if (blank_(deal.o.paid_at)) put_(tab_('Pipeline'), deal, { paid_at: now_() });
    setStage_(deal, '7 Closed Won');
    startSeq_('W', deal);
    return 'ok won';
  },
  'deal.lost': function (email, d) {
    var deal = needDeal_(email);
    var reason = String(d.lost_reason || '').trim();
    var known = SCHEMA.lists.lost_reason.filter(function (r) { return norm_(r) === norm_(reason); })[0];
    put_(tab_('Pipeline'), deal, { lost_reason: known || reason, next_action: '', next_follow_up: '', updated_at: now_() });
    if (known === 'Timing') { setStage_(deal, '9 Nurture'); return 'ok lost on timing: Nurture'; }
    setStage_(deal, '8 Closed Lost');
    return 'ok lost';
  },
  'sequence.sent': function (email, d) {
    var t = tab_('Sequences');
    var hit = find_(t, 'email', email, function (o) {
      return o.sequence === d.sequence && String(o.step) === String(d.step) && o.channel === d.channel && ['pending', 'due'].indexOf(String(o.status)) >= 0;
    });
    var outcome = blank_(d.outcome) ? '' : String(d.outcome);
    if (hit) { put_(t, hit, { status: 'sent', sent_at: now_(), outcome: outcome }); return 'ok marked sent'; }
    add_(t, { id: uid_('S'), created_at: now_(), email: email, deal_id: '', sequence: d.sequence || '', step: d.step || '', channel: d.channel || '', due_at: now_(), status: 'sent', sent_at: now_(), outcome: outcome, note: 'reported by another tool' });
    return 'ok logged' + (outcome ? ' (' + outcome + ')' : '');
  },
  'contact.quick_reply': function (email, d, ev) {
    var kw = String(d.keyword || '').toUpperCase().replace(/[^A-Z]/g, '');
    if (['YES', 'CAL', 'CANT'].indexOf(kw) < 0) throw new Error('keyword must be YES, CAL or CANT');
    if (!find_(tab_('Contacts'), 'email', email)) upsertContact_(email, {}, ev.event);
    // Logged only: no last_reply_at and no cancelling, so live-day reminders keep running.
    add_(tab_('Sequences'), { id: uid_('S'), created_at: now_(), email: email, deal_id: '', sequence: 'QUICK_REPLY', step: kw, channel: d.channel || '', due_at: now_(), status: 'received', sent_at: now_(), note: 'quick reply; live-day reminders continue' });
    if (kw === 'CANT') {
      var t = tab_('Webinar');
      var w = !blank_(ev.webinar_date) ? webinarRow_(email, ev.webinar_date) : find_(t, 'email', email);
      if (!w) return 'ok CANT logged (no webinar row to move to replay)';
      put_(t, w, { track: 'replay', updated_at: now_() });
      return 'ok CANT: replay track';
    }
    var deal = kw === 'YES' ? openDeal_(email) : null;
    if (deal && String(deal.o.stage) === '2 Call Booked') return HANDLERS['call.confirmed'](email, d);
    return 'ok ' + kw + ' logged';
  },
  'contact.replied': function (email, d) {
    if (/^\s*stop\b/i.test(String(d.text || ''))) return HANDLERS['contact.opted_out'](email, d);
    var c = find_(tab_('Contacts'), 'email', email);
    if (!c) return 'ok (unknown contact)';
    var deal = openDeal_(email);
    if (deal && String(deal.o.stage) === '2 Call Booked' && /^\s*(yes|y|confirmed?)\b/i.test(String(d.text || ''))) {
      return HANDLERS['call.confirmed'](email, d);
    }
    put_(tab_('Contacts'), c, { last_reply_at: now_(), updated_at: now_() });
    var n = cancelSeqs_(email, function (s) { return s.stops_on_reply; }, 'lead replied');
    if (deal) {
      startTask_(deal, 'Reply from ' + (c.o.first_name || email) + ' on ' + (d.channel || 'a channel') + ': answer inside 5 minutes and log it in Pipeline notes.');
      alertCloser_('reply', deal, c, d);
    }
    return 'ok replied, ' + n + ' steps stopped';
  },
  'contact.opted_out': function (email, d) {
    var c = find_(tab_('Contacts'), 'email', email) || upsertContact_(email, {}, 'contact.opted_out');
    put_(tab_('Contacts'), c, { do_not_contact: true, updated_at: now_() });
    var n = cancelSeqs_(email, function () { return true; }, 'opted out (' + (d.channel || '') + ')', true);
    return 'ok do not contact, ' + n + ' steps stopped';
  }
};

function needDeal_(email) {
  var deal = openDeal_(email);
  if (!deal) throw new Error('no open deal for ' + email);
  return deal;
}

function pick_(d, keys, extra) {
  var o = extra || {};
  keys.forEach(function (k) { if (!blank_(d[k])) o[k] = k === 'deal_value' ? Number(d[k]) : k === 'paid_at' ? (toDate_(d[k]) || d[k]) : d[k]; });
  return o;
}

function retargetUntil_(date) {
  var d = date instanceof Date ? date : toDate_(String(date) + 'T12:00:00Z');
  return d ? addMin_(d, Number(setting_('retarget_days', 42)) * 1440) : '';
}

function startTask_(deal, text) {
  add_(tab_('Sequences'), { id: uid_('S'), created_at: now_(), email: deal.o.email, deal_id: deal.o.deal_id, sequence: 'TASK', step: 'reply', channel: 'task', due_at: now_(), status: 'due', assignee: deal.o.closer || '', text: text });
}

function onNoShowUnmarked_(email) {
  var deal = openDeal_(email);
  if (!deal) return 'logged (no open deal)';
  startTask_(deal, 'Cal.com no-show was unmarked for ' + (deal.o.first_name || email) + '. Check the call happened, then log Showed, Not ready or Proposal sent. The stage was not changed.');
  return 'ok unmark task (stage ' + deal.o.stage + ' unchanged)';
}

function onMeetingEnded_(email, d) {
  var deal = openDeal_(email);
  if (!deal) return 'ignored (no open deal)';
  if (callNo_(deal, d) === 2) {
    if (['Booked', 'Rescheduled'].indexOf(String(deal.o.call2_status)) < 0) return 'ignored (Call 2 outcome already logged)';
    startTask_(deal, 'Proposal Review ended: log the outcome for ' + (deal.o.first_name || email) + ' now (Call 2 Showed or Call 2 No-Show).');
    return 'ok Call 2 outcome task';
  }
  if (['2 Call Booked', '3 Confirmed'].indexOf(String(deal.o.stage)) < 0) return 'ignored (outcome already logged)';
  startTask_(deal, 'Meeting ended: log the outcome for ' + (deal.o.first_name || email) + ' now (Showed, No-Show, Not ready or Proposal sent).');
  return 'ok outcome task';
}

/* ---------- Call 2: the Proposal Review (CRM_CONTRACT "Call 2", Adi 2026-11-05) ----------
 * A sub-status inside 5 Proposal Sent (call2_date, call2_status); it never moves a deal back to Call Booked.
 * Same closer as Call 1: the deal's closer is kept even if the booking came in on another closer's link. */

/* 1 or 2. data.call wins (the Cal.com slug or the poster says so); else the booking uid; else, for outcomes
 * logged from the sheet (infer), a Call 2 that is booked and not yet logged counts as Call 2. */
function callNo_(deal, d, infer) {
  if (d && !blank_(d.call)) return String(d.call) === '2' ? 2 : 1;
  if (!deal) return 1;
  if (d && !blank_(d.cal_uid)) {
    if (!blank_(deal.o.call2_cal_uid) && String(d.cal_uid) === String(deal.o.call2_cal_uid)) return 2;
    if (String(d.cal_uid) === String(deal.o.cal_uid)) return 1;
  }
  if (infer && !blank_(deal.o.call2_date) && ['Booked', 'Rescheduled'].indexOf(String(deal.o.call2_status)) >= 0) return 2;
  return 1;
}

var CALL2_STAGES_ = ['4a Showed', '5 Proposal Sent', '6 Follow-Up', '9 Nurture'];

function onCall2Booking_(email, d, ev, status) {
  var c = upsertContact_(email, d, ev.event);
  var deal = openDeal_(email);
  if (!deal) {
    var last = find_(tab_('Pipeline'), 'email', email);
    if (last) alertCloser_('Call 2 booked with no open deal (stage ' + last.o.stage + '): check it', last, c, d);
    return 'ok (Call 2 booked with no open deal: nothing changed' + (last ? ', closer alerted)' : ')');
  }
  var stage = String(deal.o.stage);
  var other = d.closer && deal.o.closer && norm_(d.closer) !== norm_(deal.o.closer);
  put_(tab_('Pipeline'), deal, {
    call2_date: toDate_(d.start) || deal.o.call2_date || '', call2_status: status,
    call2_cal_uid: d.cal_uid || deal.o.call2_cal_uid || '', call2_join_link: d.join_link || deal.o.call2_join_link || '',
    closer: deal.o.closer || d.closer || '', next_follow_up: toDate_(d.start) || '',
    next_action: 'Proposal Review (Call 2): walk through the proposal, ask for the decision', updated_at: now_()
  });
  // Booked: stop every chasing sequence (Seq. D, Follow-Up, RC, RN, RS), then restart the Call 2 logistics.
  cancelSeqs_(email, function (s) { return s.stops_on_reply; }, 'Call 2 ' + status.toLowerCase());
  cancelIds_(email, ['R'], 'replaced by a new Call 2 booking');
  var moved = '';
  if (CALL2_STAGES_.indexOf(stage) >= 0 || !blank_(deal.o.proposal_sent_at)) {
    if (stage !== '5 Proposal Sent') moved = ', ' + stage + ' to 5 Proposal Sent';
    setStage_(deal, '5 Proposal Sent');
    startSeq_('R', deal);
  }
  alertCloser_('Call 2 ' + status.toLowerCase() + (other ? ' (booked on ' + d.closer + "'s link; the deal stays with " + deal.o.closer + ')' : ''), deal, c, d);
  if (!moved && String(deal.o.stage) !== '5 Proposal Sent') return 'ok Call 2 ' + status.toLowerCase() + ' (stage ' + stage + ' kept: no proposal logged yet; no reminders)';
  return 'ok Call 2 ' + status.toLowerCase() + moved;
}

function onCall2Cancelled_(deal, c, d) {
  var note = 'Call 2 cancelled ' + Utilities.formatDate(now_(), 'UTC', 'yyyy-MM-dd') + (d.reason ? ': ' + d.reason : '');
  put_(tab_('Pipeline'), deal, { call2_date: '', call2_status: '', notes: [deal.o.notes, note].filter(Boolean).join('\n'), next_action: 'Rebook the Proposal Review (Seq. RC running)', updated_at: now_() });
  cancelIds_(deal.o.email, ['R'], 'Call 2 cancelled');
  if (String(deal.o.stage) !== '5 Proposal Sent') return 'ok Call 2 cancelled (stage ' + deal.o.stage + ' kept)';
  if (!truthy_(c.o.do_not_contact)) startSeq_('RC', deal);
  return 'ok Call 2 cancelled, Seq. RC started';
}

function onCall2Showed_(deal, d) {
  put_(tab_('Pipeline'), deal, pick_(d, ['notes', 'budget', 'objections'], { call2_status: 'Showed', next_action: 'Decision: agreement and payment link, then Won or Lost', next_follow_up: addMin_(now_(), 1440), updated_at: now_() }));
  cancelIds_(deal.o.email, ['R', 'RN'], 'Call 2 showed');
  if (String(deal.o.stage) === '6 Follow-Up') setStage_(deal, '5 Proposal Sent');
  startSeq_('RS', deal);
  return 'ok Call 2 showed, Seq. RS started';
}

function onCall2NoShow_(deal, email) {
  if (String(deal.o.call2_status) === 'No-Show') return 'ok (Call 2 already no-show)';
  var rebook = setting_('seq_c_rebook') === 'ON';
  put_(tab_('Pipeline'), deal, { call2_status: 'No-Show', next_action: rebook ? 'Seq. RN rebook running' : 'No rebook (description rule); Nurture at +7 days', updated_at: now_() });
  if (!rebook) put_(tab_('Contacts'), find_(tab_('Contacts'), 'email', email), { no_rebook: true });
  cancelIds_(email, ['R'], 'Call 2 no-show');
  startSeq_('RN', deal);
  return 'ok Call 2 no-show, Seq. RN started (rebook ' + (rebook ? 'ON' : 'OFF') + ')';
}

/* ---------- closer alert: lead brief from the form and the webinar ---------- */

function webinarBrief_(email) {
  var lines = [];
  each_(tab_('Webinar'), function (h) {
    if (norm_(h.o.email) !== email) return;
    var polls = Object.keys(h.o).filter(function (k) { return /^poll_/.test(k) && !blank_(h.o[k]); }).map(function (k) { return k + ': ' + h.o[k]; });
    lines.push('- ' + fmtDateOnly_(h.o.webinar_date) + ': ' + (h.o.segment || 'registered') +
      (truthy_(h.o.attended) ? ', ' + h.o.minutes_in_room + ' min in room' : '') +
      (truthy_(h.o.cta_clicked) ? ', clicked the offer' : '') + (polls.length ? ', ' + polls.join(', ') : ''));
  });
  return lines.length ? lines.join('\n') : '- No webinar record (booked from another source)';
}

function fmtDateOnly_(v) { var d = toDate_(v); return d ? Utilities.formatDate(d, 'UTC', 'yyyy-MM-dd') : String(v); }

function alertCloser_(kind, deal, contact, d) {
  if (setting_('alert_emails', 'ON') !== 'ON') return;
  var to = personEmail_(deal.o.closer);
  var setterEmail = blank_(setting_('setter_email')) ? '' : setting_('setter_email');
  if (!to && !setterEmail) return;
  var c = contact.o, f = mergeFields_(c, deal.o);
  var closerTz = setting_('default_timezone', 'Europe/London');
  var isCall2 = /^Call 2/.test(kind);
  var call = toDate_(isCall2 ? deal.o.call2_date : deal.o.call_date);
  if (isCall2) { f.call_day = f.call2_day; f.call_time = f.call2_time; f.join_link = f.call2_join_link; }
  var sheetLink = ss_().getUrl() + '#gid=' + tab_('Pipeline').sh.getSheetId() + '&range=A' + (deal.i + 2);
  var body = [
    (kind === 'new booking' ? 'New Enterprise Evaluation Call booked. Confirm it inside 5 minutes.' : 'Update: ' + kind + '.'),
    '',
    'Lead: ' + [c.first_name, c.last_name].filter(Boolean).join(' ') + ' <' + c.email + '>' + (c.company ? ', ' + c.company : ''),
    'WhatsApp: ' + (c.whatsapp || 'not given') + (truthy_(c.do_not_contact) ? '  (DO NOT CONTACT: opted out)' : ''),
    (isCall2 ? 'Proposal Review (Call 2): ' : 'Call: ') + (call ? f.call_day + ' ' + f.call_time + ' ' + f.lead_timezone + ' (lead) / ' + fmt_(call, closerTz, 'EEE d MMM h:mm a') + ' ' + closerTz : 'n/a'),
    'Join: ' + f.join_link,
    '',
    'Booking answers:',
    '- Revenue band: ' + (c.revenue_band || '?'),
    '- $10K+ to invest in 12 months: ' + (c.invest_12m || '?'),
    '- Main channel: ' + (c.main_channel || '?'),
    '- Biggest bottleneck: ' + (c.bottleneck || '?'),
    '- Who signs off: ' + (c.signoff || '?'),
    '',
    'Webinar behaviour:',
    webinarBrief_(c.email),
    '',
    'Source: ' + (c.lead_source || '?') + (c.utm_source ? ' (utm ' + c.utm_source + ' / ' + (c.utm_campaign || '') + ')' : ''),
    (kind === 'reply' && d && d.text ? 'Their reply: ' + d.text : ''),
    '',
    'Pipeline row: ' + sheetLink,
    (blank_(setting_('playbook_url')) ? '' : 'Script and checklist: ' + setting_('playbook_url'))
  ].filter(function (l) { return l !== null; }).join('\n');
  var subject = (kind === 'new booking' ? 'New call: ' : 'CRM ' + kind + ': ') + (c.first_name || c.email) + (c.company ? ' (' + c.company + ')' : '') + (call ? ', ' + f.call_day + ' ' + f.call_time : '');
  MailApp.sendEmail({ to: [to, setterEmail].filter(Boolean).join(','), subject: subject, body: body });
}


/* ===== 3_runner.gs ===== */
/* Follow-up runner: a time-driven trigger calls runFollowUps every 5 minutes (installed by setup). */

function runFollowUps() {
  resetTables_();
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var t = tab_('Sequences');
    var nowD = now_();
    var due = [];
    each_(t, function (h) {
      if (String(h.o.status) !== 'pending') return;
      var d = toDate_(h.o.due_at);
      if (d && d <= nowD) due.push(h);
    });
    due.sort(function (a, b) { return toDate_(a.o.due_at) - toDate_(b.o.due_at); });
    var counts = {};
    due.forEach(function (h) {
      var r = runStep_(h);
      counts[r] = (counts[r] || 0) + 1;
    });
    flushAll_();
    return counts;
  } finally {
    lock.releaseLock();
  }
}

function stepDef_(row) {
  var seq = SEQUENCES[row.sequence];
  if (!seq) return null;
  return seq.steps.filter(function (s) { return s.id === row.step && s.channel === row.channel; })[0] || null;
}

function runStep_(h) {
  var t = tab_('Sequences');
  var row = h.o;
  var set = function (status, note, extra) { put_(t, h, merge_({ status: status, note: note || '' }, extra || {})); return status; };
  var seq = SEQUENCES[row.sequence], step = stepDef_(row);
  if (!seq || !step) return set('cancelled', 'unknown sequence step');
  var contact = find_(tab_('Contacts'), 'email', row.email);
  var deal = find_(tab_('Pipeline'), 'deal_id', row.deal_id);
  if (!contact || !deal) return set('cancelled', 'contact or deal missing');
  var c = contact.o, d = deal.o, nowD = now_();

  // Stop conditions
  if (seq.valid_stages.indexOf(String(d.stage)) < 0) return set('cancelled', 'stage is ' + d.stage);
  var outbound = step.channel === 'whatsapp' || step.channel === 'email';
  if (outbound && truthy_(c.do_not_contact)) return set('cancelled', 'do not contact');
  var replied = toDate_(c.last_reply_at), created = toDate_(row.created_at);
  if (seq.stops_on_reply && replied && created && replied > created) return set('cancelled', 'lead replied');
  if (step.switch && setting_(step.switch) !== 'ON') return set('skipped', 'switch ' + step.switch + ' is OFF');
  if (step.skip_if && truthy_(c[step.skip_if])) return set('skipped', 'contact flagged ' + step.skip_if);
  var dueAt = toDate_(row.due_at);
  if (step.expires_minutes && nowD > addMin_(dueAt, step.expires_minutes)) return set('skipped', 'too late to send');
  var call = toDate_(seq.call === 2 ? d.call2_date : d.call_date);
  if (step.expires_at_call && call && nowD >= call) return set('skipped', 'call already started');

  if (step.lead_hours) {
    var open = whatsappWindow_(nowD, tzOf_(c));
    if (open > nowD) { put_(t, h, { due_at: open, note: 'waiting for 08:00 lead time (no calls or voice notes at night)' }); return 'deferred'; }
  }
  if (step.channel === 'whatsapp') {
    if (blank_(c.whatsapp)) return set('skipped', 'no WhatsApp number');
    var next = whatsappWindow_(nowD, tzOf_(c));
    if (next > nowD) {
      if (step.expires_at_call && call && next >= call) return set('skipped', 'outside WhatsApp hours before the call');
      put_(t, h, { due_at: next, note: 'waiting for the WhatsApp window (08:00 to 20:00 lead time)' });
      return 'deferred';
    }
  }

  var result;
  if (step.channel === 'system') {
    var m = /^stage:(.+)$/.exec(step.action || '');
    if (m) setStage_(deal, m[1], 'runner');
    result = set('done', step.text);
  } else {
    var f = mergeFields_(c, d);
    var body = (step.text_if_confirmed && String(d.stage) === '3 Confirmed') ? step.text_if_confirmed : step.text;
    var text = render_(body, f), subject = render_(step.subject || '', f);
    var fill = /FILL_\w*/.exec(text + ' ' + subject);
    if (fill) {
      result = set('blocked', 'fill ' + fill[0] + ' on the Lists tab, then set status back to pending', { text: text, subject: subject });
    } else if (step.channel === 'task') {
      result = set('due', '', { text: text, subject: subject, assignee: row.assignee || assigneeFor_(step, deal) });
      notifyTask_(row.assignee || assigneeFor_(step, deal), text, c);
    } else {
      result = dispatch_(h, c, d, step, subject, text);
    }
  }
  if (step.repeat_minutes && ['sent', 'due', 'done'].indexOf(result) >= 0) {
    add_(t, merge_(row, { id: uid_('S'), created_at: nowD, due_at: addMin_(nowD, step.repeat_minutes), status: 'pending', sent_at: '', subject: '', text: '', note: 'repeat' }));
  }
  return result;
}

/* queue: the closer sends from Tantra and marks the row sent (menu). tantra: send through the Tantra API (unverified). */
function dispatch_(h, c, d, step, subject, text) {
  var t = tab_('Sequences');
  var mode = setting_('dispatch_mode', 'queue');
  if (mode !== 'tantra') {
    put_(t, h, { status: 'due', subject: subject, text: text, assignee: d.closer || h.o.assignee, note: 'send from Tantra (' + step.channel + '), then mark sent' });
    notifyTask_(d.closer || h.o.assignee, 'Send this ' + step.channel + ' to ' + (c.whatsapp && step.channel === 'whatsapp' ? c.whatsapp : c.email) + ' now, from Tantra:\n\n' + (subject ? 'Subject: ' + subject + '\n\n' : '') + text, c);
    return 'due';
  }
  try {
    tantraSend_(c, step.channel, subject, text, h.o.sequence + ' ' + h.o.step + ' ' + c.email);
    put_(t, h, { status: 'sent', sent_at: now_(), subject: subject, text: text, note: 'sent via Tantra API' });
    return 'sent';
  } catch (err) {
    put_(t, h, { status: 'failed', subject: subject, text: text, note: String(err && err.message || err).slice(0, 300) });
    return 'failed';
  }
}

function notifyTask_(who, text, c) {
  if (setting_('alert_emails', 'ON') !== 'ON') return;
  var to = personEmail_(who) || (blank_(setting_('setter_email')) ? '' : setting_('setter_email'));
  if (!to) return;
  MailApp.sendEmail({ to: to, subject: 'CRM task: ' + (c.first_name || c.email) + (c.company ? ' (' + c.company + ')' : ''), body: text + '\n\nOpen the Sequences tab, do it, then Tantra CRM, Mark selected Sequences row sent or done.' });
}

/* Single-step Tantra campaign per message. Field names from tantra-api.md (simulator verified, live UNVERIFIED).
 * Needs Script Property TANTRA_API_KEY and Lists settings tantra_list_id (an EMPTY list),
 * tantra_whatsapp_account_id or tantra_email_account_id. */
function tantraSend_(c, channel, subject, text, name) {
  var key = PropertiesService.getScriptProperties().getProperty('TANTRA_API_KEY');
  if (!key) throw new Error('TANTRA_API_KEY missing in Script Properties');
  var list = setting_('tantra_list_id');
  if (!list) throw new Error('tantra_list_id missing on the Lists tab');
  var call = function (path, body) {
    var r = UrlFetchApp.fetch('https://api.usetantra.com/api/v1' + path, {
      method: 'post', contentType: 'application/json', headers: { 'x-api-key': key },
      payload: JSON.stringify(body), muteHttpExceptions: true
    });
    var code = r.getResponseCode();
    if (code >= 300) throw new Error('Tantra ' + path + ' answered ' + code + ': ' + r.getContentText().slice(0, 200));
    try { return JSON.parse(r.getContentText() || '{}'); } catch (e) { return {}; }
  };
  var camp = { name: ('CRM ' + name).slice(0, 200), contactListIds: [list], status: 'draft' };
  var step;
  if (channel === 'whatsapp') {
    camp.channelAccountIds = { whatsapp: [setting_('tantra_whatsapp_account_id')] };
    step = { order: 0, delayDays: 0, channel: 'whatsapp', action: 'send_message', messageTemplate: text };
  } else {
    camp.selectedSenderAccountIds = [setting_('tantra_email_account_id')];
    var html = text.split('\n\n').map(function (p) { return '<p>' + p.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') + '</p>'; }).join('');
    step = { order: 0, delayDays: 0, channel: 'email', action: 'send_email', subjectTemplate: subject, bodyHtmlTemplate: html, bodyTextTemplate: text, personalizationMode: 'template_only', replyToSameThread: false };
  }
  var created = call('/email-campaigns', camp);
  var id = created._id || (created.campaign && created.campaign._id) || (created.data && created.data._id);
  if (!id) throw new Error('Tantra gave no campaign id');
  call('/email-campaigns/' + id + '/steps', step);
  call('/email-campaigns/' + id + '/contacts', { contacts: [{ email: c.email, firstName: c.first_name || '', whatsappPhone: c.whatsapp || '' }] });
  call('/email-campaigns/' + id + '/start', {});
}


/* ===== 4_import.gs ===== */
/* WebinarJam attendance import. Adi: File, Import, Upload the WebinarJam attendee CSV, Insert new sheet(s),
 * rename the new tab to "WJ Import", then Tantra CRM, Import WebinarJam attendance.
 * WebinarJam export headers are UNVERIFIED, so columns are matched by the aliases below (case-insensitive). */

var WJ_ALIASES = {
  email: ['email', 'e-mail', 'email address'],
  attended: ['attended', 'attended live', 'live attendance', 'showed up', 'attendance'],
  minutes: ['time in room', 'time in session', 'time live', 'minutes in room', 'minutes', 'duration', 'time attended', 'live time', 'watched'],
  joined: ['entered', 'time entered', 'entered at', 'entered room', 'join time', 'time joined', 'joined'],
  left: ['left', 'time left', 'left at', 'left room', 'exit time']
};

function importWebinarJamAttendance() {
  var ui = SpreadsheetApp.getUi();
  var sh = ss_().getSheetByName('WJ Import');
  if (!sh) { ui.alert('No "WJ Import" tab. File, Import, Upload the WebinarJam CSV, choose Insert new sheet(s), rename the new tab to WJ Import, then run this again.'); return; }
  var ans = ui.prompt('Webinar date', 'Date of the webinar in this export (YYYY-MM-DD):', ui.ButtonSet.OK_CANCEL);
  if (ans.getSelectedButton() !== ui.Button.OK) return;
  var date = ans.getResponseText().trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { ui.alert('Use the form 2026-11-12.'); return; }
  resetTables_();
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var res = importAttendanceRows_(sh.getDataRange().getValues(), date);
    flushAll_();
    ui.alert('Imported ' + date + ': ' + res.attended + ' attended (' + res.stayed + ' stayed to the offer, ' + res.early + ' left early), ' +
      res.noShow + ' no-shows, ' + res.skipped + ' rows skipped. Columns used: ' + JSON.stringify(res.columns) + '. You can delete the WJ Import tab now.');
  } finally {
    lock.releaseLock();
  }
}

function wjColumn_(headers, key) {
  var names = headers.map(function (h) { return norm_(h); });
  var aliases = WJ_ALIASES[key];
  for (var a = 0; a < aliases.length; a++) { var i = names.indexOf(aliases[a]); if (i >= 0) return i; }
  for (var b = 0; b < aliases.length; b++) {
    for (var j = 0; j < names.length; j++) if (names[j].indexOf(aliases[b]) >= 0) return j;
  }
  return -1;
}

/* "01:05:30", "05:30", "65", "1h 5m", 65 (number) or a Sheets time value (Date) to whole minutes. */
function parseMinutes_(v) {
  if (v === null || v === undefined || v === '') return 0;
  if (v instanceof Date) return v.getUTCHours() * 60 + v.getUTCMinutes() + (v.getUTCSeconds() >= 30 ? 1 : 0);
  if (typeof v === 'number') return v < 1 ? Math.round(v * 1440) : Math.round(v);
  var s = String(v).trim().toLowerCase();
  var hm = /^(\d+):(\d{1,2})(?::(\d{1,2}))?$/.exec(s);
  if (hm) return hm[3] !== undefined ? Number(hm[1]) * 60 + Number(hm[2]) + (Number(hm[3]) >= 30 ? 1 : 0) : Number(hm[1]) + (Number(hm[2]) >= 30 ? 1 : 0);
  var h = /(\d+)\s*h/.exec(s), m = /(\d+)\s*m/.exec(s);
  if (h || m) return (h ? Number(h[1]) * 60 : 0) + (m ? Number(m[1]) : 0);
  var n = Number(s);
  return isNaN(n) ? 0 : Math.round(n);
}

function importAttendanceRows_(values, date) {
  var headers = values[0] || [];
  var cols = {};
  Object.keys(WJ_ALIASES).forEach(function (k) { cols[k] = wjColumn_(headers, k); });
  if (cols.email < 0) throw new Error('No email column in the export');
  var res = { attended: 0, stayed: 0, early: 0, noShow: 0, skipped: 0, columns: {} };
  Object.keys(cols).forEach(function (k) { res.columns[k] = cols[k] >= 0 ? String(headers[cols[k]]) : '(none)'; });
  var cutoff = Number(setting_('retarget_cutoff_minute', 25));
  var seen = {};
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var email = norm_(row[cols.email]);
    if (!isEmail_(email) || seen[email]) { res.skipped++; continue; }
    seen[email] = true;
    var mins = cols.minutes >= 0 ? parseMinutes_(row[cols.minutes]) : 0;
    var flag = cols.attended >= 0 ? truthy_(row[cols.attended]) : mins > 0;
    if (flag && mins === 0) mins = 1;
    if (flag) {
      processEvent_({ event: 'webinar.attended', email: email, source: 'webinarjam_import', webinar_date: date,
        data: { minutes_in_room: mins, joined_at: cols.joined >= 0 ? String(row[cols.joined]) : '', left_at: cols.left >= 0 ? String(row[cols.left]) : '' } });
      res.attended++;
      if (mins >= cutoff) res.stayed++; else res.early++;
    } else {
      processEvent_({ event: 'webinar.no_show', email: email, source: 'webinarjam_import', webinar_date: date, data: {} });
      res.noShow++;
    }
  }
  return res;
}


